# Foundry CLI Environment Configuration
# Copy this file to .env and fill in actual values.
# DO NOT commit .env to version control.

# Required: Authentication
# Your Foundry API token (personal or service account)
FOUNDRY_TOKEN=your_foundry_api_token_here

# Required: Target Foundry instance hostname
# E.g., https://foundry.example.com
FOUNDRY_HOSTNAME=your_foundry_hostname_here

# Optional: Explicit .env file override (ADR-006)
# If set, loads from this exact path; no fallback to git root.
# FOUNDRY_AGENTIC_CLI_ENV_FILE=/path/to/.env

# Optional: Request timeout in seconds (default: 30, ADR-002; valid range 1-3600)
# FOUNDRY_AGENTIC_CLI_TIMEOUT_S=30

# Optional: Output format auto-selection (json | toon | auto)
# FOUNDRY_AGENTIC_CLI_DEFAULT_FORMAT=auto

# Optional: Global read-only access guard (true | false)
# FOUNDRY_AGENTIC_CLI_READONLY=false

# Optional: Global metadata-only output guard (true | false)
# FOUNDRY_AGENTIC_CLI_METADATA_ONLY=false

# Optional: Attribution propagation
# FOUNDRY_AGENTIC_CLI_ENABLE_ATTRIBUTION=false
# FOUNDRY_AGENTIC_CLI_ATTRIBUTION_RIDS=rid-a,rid-b

# Optional: B3 tracing propagation
# FOUNDRY_AGENTIC_CLI_ENABLE_TRACING=false

# Optional: Structured logging level for stderr (ADR-005)
# FOUNDRY_AGENTIC_CLI_LOG_LEVEL=WARNING

# Optional: Retry configuration (ADR-002, implemented in foundry_cli.common.retry)
# FOUNDRY_AGENTIC_CLI_RETRY_MAX_ATTEMPTS=4
# FOUNDRY_AGENTIC_CLI_RETRY_INITIAL_DELAY_MS=500
# FOUNDRY_AGENTIC_CLI_RETRY_MAX_DELAY_MS=30000
# FOUNDRY_AGENTIC_CLI_RETRY_MULTIPLIER=2.0
# FOUNDRY_AGENTIC_CLI_RETRY_JITTER=true

# Optional: Pagination defaults
# FOUNDRY_AGENTIC_CLI_DEFAULT_PAGE_SIZE=100
# FOUNDRY_AGENTIC_CLI_MAX_BATCH_PAGES=40

# Optional: Binary download and session storage (DEV-STORY-004)
# FOUNDRY_AGENTIC_CLI_MAX_DOWNLOAD_BYTES=1572864
# FOUNDRY_AGENTIC_CLI_DOWNLOAD_PATH=.foundry-data/downloads
# FOUNDRY_AGENTIC_CLI_SESSION_PATH=.foundry-data/sessions

# Optional: Error envelope tracebacks (set false in production to reduce path leakage)
# FOUNDRY_INCLUDE_TRACEBACK=false
