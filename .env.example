# Foundry CLI Environment Configuration
# Copy this file to .env and fill in actual values.
# DO NOT commit .env to version control.

# Required: Authentication
# Your Foundry API token (personal or service account)
FOUNDRY_TOKEN=your_foundry_api_token_here

# Required: Target Foundry instance hostname
# E.g., https://foundry.example.com
FOUNDRY_HOSTNAME=your_foundry_hostname_here

# Optional: Explicit .env file override (ADR-006)
# If set, loads from this exact path; no fallback to git root.
# FOUNDRY_AGENTIC_CLI_ENV_FILE=/path/to/.env

# Optional: Attribution header (for agent tracking)
# E.g., "copilot-agent/1.0"
# FOUNDRY_ATtribution="agent-name/version"

# Optional: Request timeout in seconds (default: 60, ADR-002)
# FOUNDRY_REQUEST_TIMEOUT=60

# Optional: Access control tier (enabled | readonly | metadata-only | disabled)
# FOUNDRY_ACCESS_CONTROL_TIER=enabled

# Optional: Metadata allow-list (JSON array of allowed metadata fields)
# FOUNDRY_METADATA_ALLOWLIST=["name","description","created_at"]
